{
  "name": "messaging-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "start": "concurrently -k -n api,web \"node dist/apps/api/src/main.js\" \"next start apps/web --hostname 127.0.0.1 --port 3000\"",
    "dev:api": "tsx watch --tsconfig tsconfig.api.json apps/api/src/main.ts",
    "dev:web": "next dev apps/web --webpack --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "tsx --tsconfig tsconfig.api.json scripts/benchmark.ts",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.yaml",
    "build": "tsc -p tsconfig.api.json && next build apps/web --webpack",
    "infra:local": "tsx scripts/local-postgres.ts",
    "infra:redis": "tsx scripts/local-redis.ts",
    "infra:prepare-redis": "tsx scripts/prepare-redis.ts",
    "db:setup": "tsx --tsconfig tsconfig.api.json scripts/setup-db.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "bullmq": "6.5.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.62.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}

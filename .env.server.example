POSTGRES_USER=ums
POSTGRES_DB=ums
POSTGRES_PASSWORD=replace-with-generated-hex-password
DATABASE_URL=postgresql://ums:${POSTGRES_PASSWORD}@postgres:5432/ums
REDIS_URL=redis://redis:6379
APP_ORIGIN=https://ums.example.com
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
COOKIE_SECURE=true
API_HOST=0.0.0.0
RUN_WORKER_IN_API=false
TRUST_PROXY_HOPS=0
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com
UMS_IMAGE=one-ums-portal:0.1.0
WEB_BIND=127.0.0.1
WEB_PORT=3000

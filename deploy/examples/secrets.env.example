# Use reachable PostgreSQL/Redis services; this file does not install either.
DATABASE_URL=postgresql://ums:replace-password@database.example.internal:5432/ums
REDIS_URL=redis://redis.example.internal:6379
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Add these only when enabling browser push in ums-config:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:operator@example.com
